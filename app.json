{
  "expo": {
    "name": "WorkOUT",
    "slug": "workout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.workout.trainer",
      "infoPlist": {
        "NSCameraUsageDescription": "WorkOUT uses the camera to scan food barcodes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.workout.trainer"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "WorkOUT uses the camera to scan food barcodes."
        }
      ]
    ],
    "scheme": "workout",
    "backgroundColor": "#0A0A0B"
  }
}
